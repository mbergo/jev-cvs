# TYPESAFE_API_KEY: Required for TypeSafe System One (Jev) API calls (https://api.typesafe.ai/v1/systemone).
# Configured via the Secrets panel in the AI Studio UI.
TYPESAFE_API_KEY="MY_TYPESAFE_API_KEY"
TYPESAFE_APY_KEY="MY_TYPESAFE_API_KEY"

# GEMINI_API_KEY: Used for downstream assistant response generation after guardrail sanitization.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
